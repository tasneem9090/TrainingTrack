@model List<NationalityModel>
@{
    ViewData["Title"] = "NationalityList";
    Layout = "~/Views/Shared/Menut.cshtml";
}


<form method="post">

    <div class="container-fluid">
        <div class="row">
            <div class="col-12">
                <table class="table table-striped table-hover table-bordered">
                    <thead>
                        <tr>
                            <th>الجنسية</th>
                            <th>الاجراءات</th>

                        </tr>

                    </thead>
                    <tbody>
                        @foreach (NationalityModel nationality in Model)
                        {
                            <tr>
                                <td>
                                    @nationality.Name

                                </td>




                                <td>
                                    <input type="submit" value="حذف" class="btn btn-primary " style="background:blue" asp-action="Delete" asp-route-id="@nationality.Id" />
                                    <input type="submit" value="تعديل" class="btn btn-primary " style="background:blue" asp-action="Edit" asp-route-id="@nationality.Id" />

                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</form>