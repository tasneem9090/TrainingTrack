@model vmTrainee
@{
    ViewData["Title"] = "NewTrainee";
    Layout = "~/Views/Shared/Menut.cshtml";
}



<form method="post">

    <body class="bg-light">

        <div class="container py-5">

            <div class="row justify-content-center">
                <div class="col-md-8 col-lg-6">

                    <div class="card shadow border-0 rounded-4">

                        <!-- Header -->
                        <div class="card-header bg-primary text-white text-center py-4 rounded-top-4">

                            <i class="bi bi-person-circle fs-1"></i>

                            <h3 class="mt-2 mb-0">
                                بيانات المتدرب
                            </h3>

                        </div>

                        <!-- Body -->
                        <div class="card-body p-4">

                            <!-- اسم المتدرب -->


                            <div class="mb-4">

                                <label class="form-label fw-bold">

                                    اسم العميل
                                </label>

                                <input type="text" class="form-control" asp-for="traineeModel.Name" placeholder="أدخل الاسم">

                            </div>

                            <div class="mb-4">


                                <label class="form-label fw-bold">الجنس</label>

                                <div class="form-check form-check-inline">
                                    <input class="form-check-input"
                                           type="radio"
                                           asp-for="traineeModel.Gender"
                                           value="ذكر"
                                           id="male">

                                    <label class="form-check-label" for="male">
                                        ذكر
                                    </label>
                                </div>

                                <div class="form-check form-check-inline">
                                    <input class="form-check-input"
                                           type="radio"
                                           asp-for="traineeModel.Gender"
                                           value="أنثى"
                                           id="female">

                                    <label class="form-check-label" for="female">
                                        أنثى
                                    </label>
                                </div>



                                <!-- رقم الهاتف -->
                                <div class="mb-4">

                                    <label class="form-label fw-bold">

                                        رقم الهاتف
                                    </label>

                                    <input type="text" class="form-control" asp-for="traineeModel.Phone" placeholder="أدخل الرقم">


                                </div>


                                <div class="mb-4">

                                    <label class="form-label fw-bold">

                                        الجنسية
                                    </label>

                                    <select class="form-select" type="text" asp-items='new SelectList(Model.linationalityModel, "Id", "Name")' asp-for="traineeModel.NationalityId">
                                    </select>
                                </div>

 

                                <!-- Button -->
                                <div class="d-grid mt-4">

                                    <input type="submit" value="اضافة" class="btn btn-primary" asp-action="Save" />

                                </div>
                            </div>
                        </div>
    </body>
</form>
