@model List<TrainingModel>
@{
    ViewData["Title"] = "TrainingList";
    Layout = "~/Views/Shared/Menut.cshtml";
}


<form method="post">

    <div class="container-fluid">
        <div class="row">
            <div class="col-12">
                <table class="table table-striped table-hover table-bordered">
                    <thead>
                        <tr>
                            <th>اسم المشروع</th>
                            <th>التاريخ</th>
                          
                            <th>الموظف</th>
                            <th>الاجراءات</th>

                        </tr>

                    </thead>
                    <tbody>
                        @foreach (TrainingModel item in Model)
                        {
                            <tr>
                                <td>
                                    @item.Name

                                </td>
                                <td>
                                    @item.StartDate
                                </td>
                                
                                <td>
                                  
                                    @($"{item.Trainer.FirstName}{item.Trainer.LastName}")
                                </td>

                                <td>
                                    <input type="submit" value="حذف" class="btn btn-primary " style="background:blue" asp-action="Delete" asp-route-id="@item.Id" />
                                    <input type="submit" value="تعديل" class="btn btn-primary " style="background:blue" asp-action="Edit" asp-route-id="@item.Id" />

                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</form>
