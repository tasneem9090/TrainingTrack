@model vmTraining

@{
    ViewData["Title"] = "NewTraining";
    Layout = "~/Views/Shared/Menut.cshtml";
}




<form method="post">

    <body class="bg-light">

        <div class="container py-5">

            <div class="row justify-content-center">
                <div class="col-md-8 col-lg-6">

                    <div class="card shadow border-0 rounded-4">

                        <!-- Header -->
                        <div class="card-header bg-primary text-white text-center py-4 rounded-top-4">

                            <i class="bi bi-person-circle fs-1"></i>

                            <h3 class="mt-2 mb-0">
                                بيانات المشروع
                            </h3>

                        </div>

                        <!-- Body -->
                        <div class="card-body p-4">

                            <!-- اسم المتدرب -->


                            <div class="mb-4">

                                <label class="form-label fw-bold">

                                    اسم المشروع
                                </label>

                                <input type="text" class="form-control" asp-for="trainingModel.Name" placeholder="أدخل الاسم">

                            </div>


                            <!-- رقم الهاتف -->
                            <div class="mb-4">

                                <label class="form-label fw-bold">

                                    التاريخ
                                </label>

                                <input type="date" class="form-control" asp-for="trainingModel.StartDate" placeholder="أدخل التاريخ">


                            </div>



                            <div class="mb-4">

                                <label class="form-label fw-bold">

                                    الموظف
                                </label>
                             @*    </label>
                                <select class="form-select" type="text" asp-items='new SelectList(Model.litrainerModels, "Id", "FirstName")' asp-for="trainingModel.TrainerId"></select>


                            </div> *@

                                    <select class="form-select" asp-for="trainingModel.TrainerId"
                                            asp-items='new SelectList(Model.litrainerModels.Select(t => new { Id = t.Id, FullName = t.FirstName + " " + t.LastName }), "Id", "FullName")'>
                                    </select>

                            <!-- Button -->
                            <div class="d-grid mt-4">

                                <input type="submit" value="اضافة" class="btn btn-primary" asp-action="Save" />

                            </div>
                        </div>
                    </div>
    </body>
</form>


