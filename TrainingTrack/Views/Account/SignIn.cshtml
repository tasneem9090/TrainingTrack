@model SignInModel
@{
    Layout = null;
}



<!DOCTYPE html>
<html lang="ar" dir="rtl">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Login</title>

    <!-- Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            min-height: 100vh;
/*             background: linear-gradient(135deg, #7650b8, #6610f2);
 */            display: flex;
            align-items: center;
            justify-content: center;
            font-family: Arial, sans-serif;

             background: var(--primary);
            
        }

        .login-container {
            width: 90%;
            max-width: 500px;
            background: white;
            padding: 55px 60px;
            border-radius: 25px;
            box-shadow: 0 15px 40px rgba(0, 0, 0, 0.2);
        }

        .login-title {
            text-align: center;
            font-size: 32px;
            font-weight: bold;
            color: #222;
            margin-bottom: 10px;
        }

        .login-subtitle {
            text-align: center;
            /* color: #777; */
            color: #85899d margin-bottom: 35px;
        }

        .form-label {
            font-weight: bold;
            margin-bottom: 8px;
        }

        .form-control {
            height: 52px;
            border-radius: 10px;
            border: 1px solid #ddd;
            padding: 10px 15px;
        }

            .form-control:focus {
                border-color: #0d6efd;
                box-shadow: 0 0 0 0.2rem rgba(13, 110, 253, 0.15);
            }

        .forgot-password {
            text-decoration: none;
            color: #85899d;
            font-size: 14px;
        }

        .btn-login {
            height: 52px;
            border-radius: 10px;
            font-size: 17px;
            font-weight: bold;
            background-color:#7650b8;
          
        }

        

        .register {
            text-align: center;
            margin-top: 25px;
            color: black;
        }

            .register a {
                color: #85899d;
                text-decoration: none;
                font-weight: bold;
            }

        /* الموبايل */
        .media (max-width: 576px) {
            body

        {
            padding: 20px;
        }

        .login-container {
            width: 100%;
            padding: 40px 25px;
        }

        .login-title {
            font-size: 27px;
        }

        }
    </style>
</head>

<body>

    <div class="login-container">

        <h2 class="login-title">
            تسجيل الدخول
        </h2>

        <p class="login-subtitle">
            أدخل بيانات حسابك للمتابعة
        </p>

        <form method="post">
            @if ((bool)ViewData["InValid"] == true){
                <div class="alert alert-danger" >
                    البريد الإلكتروني أو كلمة المرور غير صحيحة
                </div>
            }
            <!-- Email -->
            <div class="mb-4">
                <label for="email" class="form-label">
                    البريد الإلكتروني
                </label>

                <input type="email"
                       id="email"
                       class="form-control"
                       placeholder="example@email.com"
                       required asp-for="Username">
            </div>

            <!-- Password -->
            <div class="mb-3">
                <label for="password" class="form-label">
                    كلمة المرور
                </label>

                <input type="password"
                       id="password"
                       class="form-control"
                       placeholder="أدخل كلمة المرور"
                       required asp-for="Password">
            </div>

            <!-- Forgot Password -->
            <div class="text-start mb-3">
                <a class="nav-link" asp-controller="Account" asp-action="SignIn" class="forgot-password">
                    نسيت كلمة المرور؟
                </a>
            </div>
         
            <!-- Login Button -->
            <input type="submit"
                   class=" mauve-purple w-100 btn-login " value="تسجيل الدخول"
                   asp-action="Login">
                    

            <!-- Register -->
            <div class="register">
                ليس لديك حساب؟

                <a class="nav-link" asp-controller="Account" asp-action="SignUp">إنشاء حساب</a>
            </div>

        </form>

    </div>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

</body>

</html>