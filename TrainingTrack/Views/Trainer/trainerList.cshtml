@model List<TrainerModel>
@{
    ViewData["Title"] = "trainerList";
    Layout = "~/Views/Shared/Menut.cshtml";
}





<form method="post">

    <div class="container-fluid">
        <div class="row">
            <div class="col-12">
                <table class="table table-striped table-hover table-bordered">
                    <thead>
                        <tr>
                            <th>الاسم الاول</th>
                            <th>الاسم الاخير</th>
                            <th>ايميل </th>
                            <th>رقم الهاتف</th>
                            <th>التاريخ</th>
                            <th>مكان الاقامة</th>
                            <th>الاجراءات</th>

                        </tr>

                    </thead>
                    <tbody>
                        @foreach (TrainerModel item in Model)
                        {
                            <tr>
                                <td>
                                    @item.FirstName

                                </td>
                                <td>
                                    @item.LastName
                                </td>
                                <td>
                                    @item.Email

                                </td>
                                <td>
                                    @item.Phone
                                </td>
                                <td>
                                    @item.DateofBirth
                                </td>
                                <td>
                                    @item.address
                                </td>
                                <td>
                                    <input type="submit" value="حذف" class="btn btn-primary " style="background:blue" asp-action="Delete" asp-route-id="@item.Id" />
                                    <input type="submit" value="تعديل" class="btn btn-primary " style="background:blue" asp-action="Edit" asp-route-id="@item.Id" />

                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</form>


