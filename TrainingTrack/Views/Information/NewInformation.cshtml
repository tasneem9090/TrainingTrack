
@{
    ViewData["Title"] = "NewInformation";
    Layout = "~/Views/Shared/Menut.cshtml";
}



<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>PixelSoft | من نحن</title>

    <!-- Bootstrap RTL -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.rtl.min.css"
          rel="stylesheet">

    <!-- Bootstrap Icons -->
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800&display=swap"
          rel="stylesheet">

    <style>
        :root {
            --primary: #101b3d;
            --primary-light: #1c2d59;
            --accent: #16c7bd;
            --accent-dark: #0da69e;
            --text: #27324a;
            --muted: #748099;
            --light: #f5f8fc;
            --white: #ffffff;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            font-family: 'Cairo', sans-serif;
            color: var(--text);
            background: var(--white);
            overflow-x: hidden;
        }

        a {
            text-decoration: none;
        }

        .section-padding {
            padding: 90px 0;
        }

        .section-label {
            display: inline-block;
            color: var(--accent-dark);
            background: rgba(22, 199, 189, 0.10);
            padding: 8px 18px;
            border-radius: 30px;
            font-size: 14px;
            font-weight: 700;
            margin-bottom: 18px;
        }

        .section-title {
            font-size: clamp(28px, 4vw, 40px);
            font-weight: 800;
            color: var(--primary);
            line-height: 1.5;
            margin-bottom: 20px;
        }

        .section-description {
            color: var(--muted);
            font-size: 16px;
            line-height: 2;
            max-width: 700px;
        }

        /* NAVBAR */

        .navbar {
            background: rgba(255, 255, 255, 0.97);
            padding: 18px 0;
            box-shadow: 0 3px 25px rgba(16, 27, 61, 0.05);
        }

        .navbar-brand {
            display: flex;
            align-items: center;
            gap: 10px;
            color: var(--primary);
            font-size: 25px;
            font-weight: 800;
        }

        .brand-icon {
            width: 45px;
            height: 45px;
            background: var(--accent);
            color: var(--primary);
            border-radius: 13px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 24px;
        }

        .navbar .nav-link {
            color: var(--text);
            font-weight: 600;
            margin: 0 8px;
            transition: 0.3s;
        }

            .navbar .nav-link:hover {
                color: var(--accent-dark);
            }

        .btn-primary-custom {
            background: var(--accent);
            color: var(--primary);
            padding: 13px 27px;
            border-radius: 10px;
            font-weight: 800;
            border: 1px solid var(--accent);
            transition: 0.3s;
        }

            .btn-primary-custom:hover {
                background: var(--accent-dark);
                border-color: var(--accent-dark);
                color: white;
                transform: translateY(-2px);
            }

        .btn-outline-custom {
            display: inline-block;
            border: 1px solid rgba(255,255,255,0.45);
            color: white;
            padding: 13px 27px;
            border-radius: 10px;
            font-weight: 700;
            transition: 0.3s;
        }

            .btn-outline-custom:hover {
                background: white;
                color: var(--primary);
            }

        /* HERO */

        .hero {
            position: relative;
            padding: 105px 0 100px;
            background: radial-gradient(circle at 10% 20%, rgba(22,199,189,0.15), transparent 30%), linear-gradient(135deg, #101b3d, #1b2c56);
            color: white;
            overflow: hidden;
        }

            .hero::before {
                content: "";
                position: absolute;
                width: 400px;
                height: 400px;
                border: 1px solid rgba(22,199,189,0.15);
                border-radius: 50%;
                top: -180px;
                left: -100px;
            }

            .hero::after {
                content: "";
                position: absolute;
                width: 300px;
                height: 300px;
                border: 1px solid rgba(255,255,255,0.08);
                border-radius: 50%;
                bottom: -150px;
                right: 20%;
            }

        .hero-content {
            position: relative;
            z-index: 2;
        }

        .hero-badge {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 9px 17px;
            background: rgba(255,255,255,0.08);
            border: 1px solid rgba(255,255,255,0.13);
            border-radius: 30px;
            color: #a6fff8;
            margin-bottom: 25px;
            font-size: 14px;
        }

        .hero h1 {
            font-size: clamp(36px, 5vw, 58px);
            font-weight: 800;
            line-height: 1.5;
            margin-bottom: 25px;
        }

            .hero h1 span {
                color: var(--accent);
            }

        .hero p {
            color: #c5cfe3;
            font-size: 17px;
            line-height: 2.1;
            max-width: 620px;
            margin-bottom: 32px;
        }

        .hero-visual {
            min-height: 350px;
            display: flex;
            align-items: center;
            justify-content: center;
            position: relative;
        }

        .visual-card {
            width: 310px;
            height: 310px;
            border-radius: 35px;
            background: linear-gradient(145deg, rgba(255,255,255,0.13), rgba(255,255,255,0.03));
            border: 1px solid rgba(255,255,255,0.15);
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            box-shadow: 0 30px 80px rgba(0,0,0,0.15);
            transform: rotate(-4deg);
        }

            .visual-card i {
                font-size: 100px;
                color: var(--accent);
                margin-bottom: 20px;
            }

            .visual-card h3 {
                font-size: 29px;
                font-weight: 800;
                color: white;
            }

            .visual-card p {
                margin: 5px 0 0;
                font-size: 14px;
            }

        .floating-icon {
            position: absolute;
            width: 65px;
            height: 65px;
            background: white;
            color: var(--primary);
            border-radius: 18px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 28px;
            box-shadow: 0 15px 35px rgba(0,0,0,0.15);
        }

            .floating-icon.one {
                top: 25px;
                right: 30px;
                color: #16b8ad;
            }

            .floating-icon.two {
                bottom: 30px;
                left: 25px;
                color: #5d7df0;
            }

        /* ABOUT */

        .about-section {
            background: white;
        }

        .about-visual {
            position: relative;
            background: var(--light);
            border-radius: 25px;
            padding: 45px;
            min-height: 400px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .about-main-icon {
            width: 180px;
            height: 180px;
            background: var(--primary);
            color: var(--accent);
            border-radius: 40px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 85px;
            box-shadow: 0 25px 60px rgba(16,27,61,0.20);
        }

        .about-tag {
            position: absolute;
            bottom: 25px;
            right: 25px;
            background: white;
            padding: 15px 20px;
            border-radius: 15px;
            box-shadow: 0 10px 35px rgba(16,27,61,0.08);
            font-weight: 700;
        }

            .about-tag i {
                color: var(--accent-dark);
                margin-left: 7px;
            }

        .about-feature {
            display: flex;
            align-items: flex-start;
            gap: 15px;
            margin-top: 25px;
        }

        .feature-icon {
            min-width: 45px;
            height: 45px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: rgba(22,199,189,0.12);
            color: var(--accent-dark);
            border-radius: 12px;
            font-size: 21px;
        }

        .about-feature h6 {
            font-weight: 800;
            color: var(--primary);
            margin-bottom: 7px;
        }

        .about-feature p {
            color: var(--muted);
            line-height: 1.9;
            font-size: 14px;
            margin: 0;
        }

        /* ACHIEVEMENTS */

        .achievements-section {
            background: var(--light);
        }

        .stat-card {
            background: white;
            border: 1px solid #edf0f7;
            border-radius: 20px;
            padding: 35px 20px;
            text-align: center;
            height: 100%;
            transition: 0.3s;
        }

            .stat-card:hover {
                transform: translateY(-8px);
                box-shadow: 0 20px 45px rgba(16,27,61,0.08);
            }

        .stat-icon {
            width: 65px;
            height: 65px;
            background: rgba(22,199,189,0.12);
            color: var(--accent-dark);
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 18px;
            margin: 0 auto 20px;
            font-size: 28px;
        }

        .stat-card h3 {
            font-size: 37px;
            font-weight: 800;
            color: var(--primary);
            margin-bottom: 10px;
        }

        .stat-card p {
            color: var(--muted);
            margin: 0;
            font-size: 14px;
        }

        /* SERVICES */

        .services-section {
            background: white;
        }

        .service-card {
            height: 100%;
            padding: 32px;
            border: 1px solid #edf0f7;
            border-radius: 20px;
            transition: 0.3s;
            background: white;
        }

            .service-card:hover {
                border-color: var(--accent);
                box-shadow: 0 20px 45px rgba(16,27,61,0.07);
                transform: translateY(-6px);
            }

        .service-icon {
            width: 60px;
            height: 60px;
            border-radius: 16px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: var(--primary);
            color: var(--accent);
            font-size: 27px;
            margin-bottom: 23px;
        }

        .service-card h5 {
            color: var(--primary);
            font-weight: 800;
            margin-bottom: 15px;
        }

        .service-card p {
            color: var(--muted);
            line-height: 2;
            font-size: 14px;
            margin: 0;
        }

        /* VISION AND FUTURE */

        .future-section {
            background: var(--primary);
            color: white;
            position: relative;
            overflow: hidden;
        }

            .future-section .section-title {
                color: white;
            }

            .future-section .section-description {
                color: #c5cfe3;
            }

        .future-card {
            background: rgba(255,255,255,0.06);
            border: 1px solid rgba(255,255,255,0.10);
            padding: 30px;
            border-radius: 20px;
            height: 100%;
            transition: 0.3s;
        }

            .future-card:hover {
                background: rgba(255,255,255,0.10);
                transform: translateY(-5px);
            }

            .future-card .future-icon {
                font-size: 35px;
                color: var(--accent);
                margin-bottom: 20px;
            }

            .future-card h5 {
                font-weight: 800;
                margin-bottom: 15px;
            }

            .future-card p {
                color: #c5cfe3;
                line-height: 2;
                font-size: 14px;
                margin: 0;
            }

        /* VALUES */

        .values-section {
            background: var(--light);
        }

        .value-item {
            display: flex;
            align-items: center;
            gap: 15px;
            background: white;
            padding: 20px;
            border-radius: 15px;
            height: 100%;
        }

            .value-item i {
                font-size: 28px;
                color: var(--accent-dark);
            }

            .value-item h6 {
                font-weight: 800;
                color: var(--primary);
                margin: 0;
            }

        /* CTA */

        .cta-section {
            padding: 80px 0;
            background: white;
        }

        .cta-box {
            background: linear-gradient(120deg, #101b3d, #233c70);
            border-radius: 25px;
            padding: 55px 35px;
            text-align: center;
            color: white;
            position: relative;
            overflow: hidden;
        }

            .cta-box h2 {
                font-size: clamp(27px, 4vw, 38px);
                font-weight: 800;
                margin-bottom: 20px;
            }

            .cta-box p {
                color: #d1daeb;
                line-height: 2;
                margin-bottom: 30px;
            }

        /* FOOTER */

        footer {
            background: #0a122a;
            color: #c5cfe3;
            padding: 35px 0;
        }

        .footer-brand {
            color: white;
            font-size: 24px;
            font-weight: 800;
        }

            .footer-brand span {
                color: var(--accent);
            }

        .footer-social a {
            width: 40px;
            height: 40px;
            border-radius: 10px;
            background: rgba(255,255,255,0.08);
            color: white;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            margin-right: 5px;
            transition: 0.3s;
        }

            .footer-social a:hover {
                background: var(--accent);
                color: var(--primary);
            }

        /* RESPONSIVE */

        .media (max-width: 991px) {
            .hero

        {
            padding: 75px 0;
        }

        .hero-visual {
            margin-top: 35px;
            min-height: 320px;
        }

        .section-padding {
            padding: 65px 0;
        }

        .navbar .btn-primary-custom {
            margin-top: 10px;
        }

        }

        .media (max-width: 576px) {
            .hero h1

        {
            font-size: 35px;
        }

        .visual-card {
            width: 250px;
            height: 250px;
        }

            .visual-card i {
                font-size: 75px;
            }

        .about-visual {
            min-height: 300px;
        }

        .about-main-icon {
            width: 140px;
            height: 140px;
            font-size: 65px;
        }

        .cta-box {
            padding: 40px 20px;
        }

        }
    </style>
</head>

<body>

    <!-- NAVBAR -->
    <nav class="navbar navbar-expand-lg sticky-top">
        <div class="container">

            <a class="navbar-brand" href="#home">
                <span class="brand-icon">
                    <i class="bi bi-code-slash"></i>
                </span>
                PixelSoft
            </a>

            <button class="navbar-toggler"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#mainNavbar"
                    aria-controls="mainNavbar"
                    aria-expanded="false"
                    aria-label="فتح القائمة">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="mainNavbar">
                <ul class="navbar-nav mx-auto mb-2 mb-lg-0">
                    <li class="nav-item">
                        <a class="nav-link" href="#home">الرئيسية</a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" href="#about">من نحن</a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" href="#achievements">إنجازاتنا</a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" href="#services">خدماتنا</a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" href="#future">رؤيتنا المستقبلية</a>
                    </li>
                </ul>

                <a href="#contact" class="btn btn-primary-custom">
                    تواصل معنا
                    <i class="bi bi-arrow-left me-1"></i>
                </a>
            </div>

        </div>
    </nav>


    <!-- HERO SECTION -->
    <section class="hero" id="home">
        <div class="container">
            <div class="row align-items-center">

                <div class="col-lg-7">
                    <div class="hero-content">

                        <div class="hero-badge">
                            <i class="bi bi-stars"></i>
                            نبني المستقبل باستخدام التكنولوجيا
                        </div>

                        <h1>
                            نحوّل أفكارك إلى
                            <span>حلول رقمية</span>
                            مبتكرة
                        </h1>

                        <p>
                            في PixelSoft، نؤمن بأن التكنولوجيا هي أساس التطور.
                            نعمل على تحويل الأفكار إلى مشاريع رقمية متكاملة
                            من خلال البرمجة الحديثة والتصميم الإبداعي
                            والحلول التقنية التي تساعد الأعمال على النمو.
                        </p>

                        <div class="d-flex flex-wrap gap-3">
                            <a href="#about" class="btn btn-primary-custom">
                                اكتشف شركتنا
                                <i class="bi bi-arrow-left me-1"></i>
                            </a>

                            <a href="#services" class="btn-outline-custom">
                                استكشف خدماتنا
                            </a>
                        </div>

                    </div>
                </div>

                <div class="col-lg-5">
                    <div class="hero-visual">

                        <div class="visual-card">
                            <i class="bi bi-code-square"></i>
                            <h3>PixelSoft</h3>
                            <p>نبتكر اليوم لنصنع الغد</p>
                        </div>

                        <div class="floating-icon one">
                            <i class="bi bi-laptop"></i>
                        </div>

                        <div class="floating-icon two">
                            <i class="bi bi-lightning-charge"></i>
                        </div>

                    </div>
                </div>

            </div>
        </div>
    </section>


    <!-- ABOUT SECTION -->
    <section class="section-padding about-section" id="about">
        <div class="container">
            <div class="row align-items-center g-5">

                <div class="col-lg-5">
                    <div class="about-visual">

                        <div class="about-main-icon">
                            <i class="bi bi-cpu"></i>
                        </div>

                        <div class="about-tag">
                            <i class="bi bi-check-circle-fill"></i>
                            الإبداع يبدأ بفكرة
                        </div>

                    </div>
                </div>

                <div class="col-lg-7">

                    <span class="section-label">من نحن</span>

                    <h2 class="section-title">
                        PixelSoft شريكك في رحلة التحول الرقمي
                    </h2>

                    <p class="section-description">
                        PixelSoft هي شركة متخصصة في تطوير البرمجيات وتقديم
                        الحلول التقنية، وتهدف إلى مساعدة الأفراد والشركات
                        على الاستفادة من التكنولوجيا في تطوير أعمالهم
                        وتحسين كفاءة عملياتهم.

                        <br><br>

                        نركز على تقديم حلول برمجية تجمع بين الجودة
                        والابتكار وسهولة الاستخدام، مع الاهتمام بفهم
                        احتياجات العملاء وتحويلها إلى منتجات رقمية
                        عملية وقابلة للتطوير.
                    </p>

                    <div class="about-feature">
                        <div class="feature-icon">
                            <i class="bi bi-bullseye"></i>
                        </div>

                        <div>
                            <h6>رسالتنا</h6>
                            <p>
                                تقديم حلول تقنية مبتكرة تساعد عملاءنا
                                على تطوير أعمالهم وتحقيق أهدافهم بكفاءة.
                            </p>
                        </div>
                    </div>

                    <div class="about-feature">
                        <div class="feature-icon">
                            <i class="bi bi-eye"></i>
                        </div>

                        <div>
                            <h6>رؤيتنا</h6>
                            <p>
                                أن نكون من الشركات المتميزة في مجال البرمجيات
                                والحلول الرقمية، وأن نساهم في بناء مستقبل
                                تقني أكثر تطورًا واستدامة.
                            </p>
                        </div>
                    </div>

                </div>

            </div>
        </div>
    </section>


    <!-- ACHIEVEMENTS SECTION -->
    <section class="section-padding achievements-section" id="achievements">
        <div class="container">

            <div class="text-center mb-5">
                <span class="section-label">إنجازاتنا</span>

                <h2 class="section-title">
                    طموحنا يتحول إلى إنجازات
                </h2>

                <p class="section-description mx-auto">
                    نسعى إلى بناء سجل من النجاحات من خلال تقديم
                    حلول تقنية عالية الجودة، وتطوير علاقات طويلة الأمد
                    مع عملائنا، والاستمرار في تحسين خدماتنا.
                </p>
            </div>

            <div class="row g-4">

                <div class="col-lg-3 col-md-6">
                    <div class="stat-card">
                        <div class="stat-icon">
                            <i class="bi bi-kanban"></i>
                        </div>

                        <h3>+</h3>
                        <p>مشاريع برمجية قيد التطوير والتوسع</p>
                    </div>
                </div>

                <div class="col-lg-3 col-md-6">
                    <div class="stat-card">
                        <div class="stat-icon">
                            <i class="bi bi-people"></i>
                        </div>

                        <h3>+</h3>
                        <p>عملاء وشركاء نتطلع إلى خدمتهم</p>
                    </div>
                </div>

                <div class="col-lg-3 col-md-6">
                    <div class="stat-card">
                        <div class="stat-icon">
                            <i class="bi bi-lightbulb"></i>
                        </div>

                        <h3>24/7</h3>
                        <p>التزام بالتطوير وتحسين الحلول</p>
                    </div>
                </div>

                <div class="col-lg-3 col-md-6">
                    <div class="stat-card">
                        <div class="stat-icon">
                            <i class="bi bi-graph-up-arrow"></i>
                        </div>

                        <h3>100%</h3>
                        <p>طموح نحو الجودة والتحسين المستمر</p>
                    </div>
                </div>

            </div>

            <div class="alert alert-info mt-4 border-0 rounded-4"
                 role="alert">
                <i class="bi bi-info-circle ms-2"></i>
                يمكن استبدال المؤشرات أعلاه بأرقام الإنجازات الفعلية
                للشركة، مثل عدد المشاريع المنجزة والعملاء ونسبة رضاهم.
            </div>

        </div>
    </section>


    <!-- SERVICES SECTION -->
    <section class="section-padding services-section" id="services">
        <div class="container">

