@model List<GovernorateModel>

@{
    ViewData["Title"] = "GovernorateList";
    Layout = "~/Views/Shared/Menut.cshtml";
}



<form method="post">

    <div class="container-fluid">
        <div class="row">
            <div class="col-12">
                <table class="table table-striped table-hover table-bordered">
                    <thead>
                        <tr>
                            <th>اسم</th>

                            <th>الاجراءات</th>

                        </tr>

                    </thead>
                    <tbody>
                        @foreach (GovernorateModel item in Model)
                        {
                            <tr>
                                <td>
                                    @item.Name

                                </td>


                                 <td>
                                    <input type="submit" value="Delete" class="btn btn-primary " style="background:blue" asp-action="Delete" asp-route-id="@item.Id" />
                                    <input type="submit" value="Eidt" class="btn btn-primary " style="background:blue" asp-action="Edit" asp-route-id="@item.Id" />

                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</form>



