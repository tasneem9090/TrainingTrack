

@model vmDailyReport

@{
    ViewData["Title"] = "NewDailyReport";
    Layout = "~/Views/Shared/Menut.cshtml";
}

<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>بيانات التقرير</title>

    <!-- Bootstrap RTL -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.rtl.min.css"
          rel="stylesheet">

    <!-- Bootstrap Icons -->
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <style>

        body {
            margin: 0;
            font-family: Tahoma, Arial, sans-serif;
            background: linear-gradient(135deg, #eef6ff 0%, #f8fbff 100%);
            min-height: 100vh;
            color: #243b53;
        }

        /* الصفحة */
        .report-page {
            min-height: calc(100vh - 40px);
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 40px 15px;
        }

        /* الكرت الرئيسي */
        .report-card {
            width: 100%;
            max-width: 750px;
            background: #ffffff;
            border: 1px solid #e3edf8;
            border-radius: 20px;
            overflow: hidden;
            box-shadow: 0 15px 45px rgba(31, 78, 121, 0.12);
        }

        /* الهيدر */
        .report-header {
            background: linear-gradient(135deg, #0d6efd, #0056c7);
            color: white;
            padding: 30px 25px;
            text-align: center;
        }

        .report-icon {
            width: 65px;
            height: 65px;
            margin: 0 auto 15px;
            border-radius: 50%;
            background: rgba(255, 255, 255, 0.18);
            border: 1px solid rgba(255, 255, 255, 0.3);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 28px;
        }

        .report-header h3 {
            margin: 0 0 8px;
            font-size: 23px;
            font-weight: bold;
        }

        .report-header p {
            margin: 0;
            font-size: 13px;
            opacity: 0.9;
        }

        /* محتوى الفورم */
        .report-body {
            padding: 30px;
        }

        /* عنوان الحقول */
        .form-label {
            font-size: 14px;
            font-weight: bold;
            color: #29445f;
            margin-bottom: 8px;
        }

        /* Input Group */
        .input-group-text {
            width: 45px;
            justify-content: center;
            background: #edf5ff;
            color: #0d6efd;
            border: 1px solid #d8e7f7;
            font-size: 16px;
        }

        /* الحقول */
        .form-control,
        .form-select {
            height: 45px;
            border: 1px solid #d8e3ef;
            background-color: #fbfdff;
            font-size: 14px;
            color: #243b53;
            transition: all 0.2s ease;
        }

            .form-control::placeholder {
                color: #9aaabd;
            }

            .form-control:focus,
            .form-select:focus {
                border-color: #0d6efd;
                background-color: #fff;
                box-shadow: 0 0 0 4px rgba(13, 110, 253, 0.10);
            }

        /* textarea */
        textarea.form-control {
            height: 110px;
            resize: vertical;
            min-height: 90px;
        }

        /* صندوق الملف */
        .file-upload {
            border: 2px dashed #c9def5;
            background: #f8fbff;
            border-radius: 14px;
            padding: 20px;
            text-align: center;
            transition: all 0.25s ease;
        }

            .file-upload:hover {
                border-color: #0d6efd;
                background: #f2f8ff;
            }

        .file-upload-icon {
            width: 55px;
            height: 55px;
            margin: 0 auto 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 12px;
            background: #e8f2ff;
            color: #0d6efd;
            font-size: 25px;
        }

        .file-upload-title {
            font-size: 14px;
            font-weight: bold;
            color: #334e68;
            margin-bottom: 5px;
        }

        .file-upload-text {
            font-size: 12px;
            color: #829ab1;
            margin-bottom: 15px;
        }

        /* زر رفع الملف */
        .upload-btn {
            display: inline-flex;
            align-items: center;
            gap: 7px;
            cursor: pointer;
            background: #0d6efd;
            color: #fff;
            border-radius: 8px;
            padding: 10px 22px;
            font-size: 13px;
            font-weight: bold;
            transition: all 0.2s ease;
        }

            .upload-btn:hover {
                background: #095dcc;
                transform: translateY(-1px);
            }

        /* اسم الملف */
        .file-name {
            margin-top: 12px;
            font-size: 12px;
            color: #52708d;
        }

        /* الصورة القديمة */
        .current-image {
            margin-top: 15px;
            padding: 15px;
            background: #f8fbff;
            border: 1px solid #e1edf8;
            border-radius: 12px;
            text-align: center;
        }

        .current-image-title {
            font-size: 13px;
            font-weight: bold;
            color: #526b84;
            margin-bottom: 10px;
        }

        .current-image img {
            max-width: 100%;
            width: 180px;
            height: 120px;
            object-fit: cover;
            border-radius: 10px;
            border: 1px solid #dce8f4;
            box-shadow: 0 5px 15px rgba(0, 0, 0, 0.08);
        }

        /* الأزرار */
        .form-actions {
            margin-top: 28px;
            display: flex;
            justify-content: center;
            gap: 10px;
        }

        .btn-save {
            min-width: 180px;
            height: 45px;
            border: none;
            border-radius: 9px;
            background: linear-gradient(135deg, #0d6efd, #0056c7);
            color: white;
            font-size: 14px;
            font-weight: bold;
            box-shadow: 0 7px 18px rgba(13, 110, 253, 0.20);
            transition: all 0.2s ease;
        }

            .btn-save:hover {
                background: linear-gradient(135deg, #095dcc, #0046a8);
                color: white;
                transform: translateY(-2px);
                box-shadow: 0 9px 22px rgba(13, 110, 253, 0.25);
            }

        /* خط فاصل */
        .section-divider {
            height: 1px;
            background: #edf2f7;
            margin: 25px 0;
        }

        /* موبايل */
        @@media (max-width: 576px) {

            .report-page {
                padding: 20px 10px;
                align-items: flex-start;
            }

            .report-card {
                border-radius: 15px;
            }

            .report-header {
                padding: 25px 15px;
            }

                .report-header h3 {
                    font-size: 20px;
                }

            .report-body {
                padding: 20px 15px;
            }

            .form-actions {
                flex-direction: column;
            }

            .btn-save {
                width: 100%;
            }
        }

    </style>
</head>

<body>

    <form method="post" enctype="multipart/form-data">

        <div class="report-page">

            <div class="report-card">

                <!-- =========================
                     Header
                ========================== -->

                <div class="report-header">

                    <div class="report-icon">
                        <i class="bi bi-file-earmark-text"></i>
                    </div>

                    <h3>بيانات التقرير</h3>

                    <p>
                        إضافة بيانات التقرير والملف الخاص به
                    </p>

                </div>


                <!-- =========================
                     Form Body
                ========================== -->

                <div class="report-body">

                    <!-- عنوان التقرير -->

                    <div class="mb-4">

                        <label class="form-label">
                            عنوان التقرير
                        </label>

                        <div class="input-group">

                            <span class="input-group-text">
                                <i class="bi bi-card-heading"></i>
                            </span>

                            <input type="text"
                                   class="form-control"
                                   asp-for="dailyReport.Name"
                                   placeholder="أدخل عنوان التقرير" />

                        </div>

                    </div>


                    <!-- اسم المدرب -->

                    <div class="mb-4">

                        <label class="form-label">
                            اسم الموظف
                        </label>

                        <div class="input-group">

                            <span class="input-group-text">
                                <i class="bi bi-person"></i>
                            </span>

                           

                                <select class="form-select" asp-for="dailyReport.TrainerId"
                                        asp-items='new SelectList(Model.litrainerModel.Select(t => new { Id = t.Id, FullName = t.FirstName + " " + t.LastName }), "Id", "FullName")'>
                              
                                <option value="">
                                    -- اختر المدرب --
                                </option>
                            </select>

                        </div>

                    </div>


                    <!-- اليوم والتاريخ -->

                    <div class="row">

                        <!-- اليوم -->

                        <div class="col-md-6 mb-4">

                            <label class="form-label">
                                اليوم
                            </label>

                            <div class="input-group">

                                <span class="input-group-text">
                                    <i class="bi bi-calendar-day"></i>
                                </span>

                                <input type="text"
                                       class="form-control"
                                       asp-for="dailyReport.Day"
                                        />

                            </div>

                        </div>


                        <!-- التاريخ -->

                        <div class="col-md-6 mb-4">

                            <label class="form-label">
                                التاريخ
                            </label>

                            <div class="input-group">

                                <span class="input-group-text">
                                    <i class="bi bi-calendar3"></i>
                                </span>

                                <input type="date"
                                       class="form-control"
                                       asp-for="dailyReport.Date" />

                            </div>

                        </div>

                    </div>


                    <!-- الملاحظات -->

                    <div class="mb-4">

                        <label class="form-label">
                            الملاحظة
                        </label>

                        <div class="input-group">

                            <span class="input-group-text align-items-start pt-3">
                                <i class="bi bi-chat-left-text"></i>
                            </span>

                            <textarea class="form-control"
                                      asp-for="dailyReport.Notes"
                                      placeholder="اكتب الملاحظة هنا..."></textarea>

                        </div>

                    </div>


                    <div class="section-divider"></div>


                    <!-- رفع الملف -->

                    <div class="mb-4">

                        <label class="form-label d-block">
                            ملف التقرير
                        </label>

                        <div class="file-upload">

                            <div class="file-upload-icon">
                                <i class="bi bi-cloud-arrow-up"></i>
                            </div>

                            <div class="file-upload-title">
                                اختر صورة أو ملف التقرير
                            </div>

                            <div class="file-upload-text">
                                يمكنك رفع صورة أو ملف التقرير
                            </div>

                            <label for="fuProfile"
                                   class="upload-btn">

                                <i class="bi bi-upload"></i>

                                اختيار الملف

                            </label>

                            <input type="file"
                                   asp-for="dailyReport.image"
                                   id="fuProfile"
                                   class="d-none" />

                            <div id="fileName"
                                 class="file-name">
                            </div>

                        </div>

                    </div>


                    <!-- الملف / الصورة الحالية -->
                    @if (Model.dailyReport != null &&
                                        !string.IsNullOrEmpty(Model.dailyReport.imgeName))
                    {
                        <input type="hidden"
                               asp-for="dailyReport.imgeName" />

                        <div class="current-image">

                            <div class="current-image-title">
                                الملف أو الصورة الحالية
                            </div>

                            <img src="~/Image/@Model.dailyReport.imgeName"
                                 alt="الصورة الحالية" />

                        </div>
                    }


                    <!-- الأزرار -->

                    <div class="form-actions">

                        @if (ViewBag.IsEdit != true)
                        {
                            <input type="submit"
                                   value="إضافة التقرير"
                                   class="btn btn-save"
                                   asp-action="Save" />
                        }
                        else
                        {
                            <input type="submit"
                                   value="تعديل الصورة"
                                   class="btn btn-save"
                                   asp-action="Updateimge" />
                        }

                    </div>

                </div>

            </div>

        </div>

    </form>


    <!-- إظهار اسم الملف المختار -->

    <script>

        const fileInput = document.getElementById("fuProfile");
        const fileName = document.getElementById("fileName");

        if (fileInput) {

            fileInput.addEventListener("change", function () {

                if (this.files.length > 0) {

                    fileName.innerHTML =
                        `<i class="bi bi-file-earmark-check text-success"></i>
                         ${this.files[0].name}`;

                } else {

                    fileName.innerHTML = "";

                }

            });

        }

    </script>

</body>
</html> 
