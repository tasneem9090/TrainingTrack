@model List<DailyReportModel>
@{
    ViewData["Title"] = "DailyReportList";
    Layout = "~/Views/Shared/Menut.cshtml";
}

<form method="post">

    <div class="container-fluid">
        <div class="row">
            <div class="col-12">
                <table class="table table-striped table-hover table-bordered">
                    <thead>
                        <tr>
                            <th>عنوان التقرير</th>
                            <th>الموظف </th>
                            <th>التاريخ</th>
                            <th>الملاحظة</th>
                            <th>اسم الملف</th>
                            <th>الاجراءات</th>

                        </tr>

                    </thead>
                    <tbody>
                        @foreach (DailyReportModel dailyReport in Model)
                        {
                            <tr>
                                <td>
                                    @dailyReport.Name

                                </td>
                                <td>
                                    @($"{dailyReport.Trainer.FirstName}\u00A0{dailyReport.Trainer.LastName}")
                                </td>
                                <td>
                                    @dailyReport.Date

                                </td>
                                <td>
                                    @dailyReport.Notes
                                </td>

                                <td>
                                    <img src="~/image/@dailyReport.imgeName" style="width:50px" />
                                </td>
                                

                                <td>
                                    <input type="submit" value="حذف" class="btn btn-primary " style="background:blue" asp-action="Delete" asp-route-id="@dailyReport.Id" />
                                    <input type="submit" value="تعديل" class="btn btn-primary " style="background:blue" asp-action="Edit" asp-route-id="@dailyReport.Id" />

                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</form>



