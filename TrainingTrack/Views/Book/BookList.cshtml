@model List<BookModel>
@{
    ViewData["Title"] = "BookList";
    Layout = "~/Views/Shared/Menut.cshtml";
}



<form method="post">

    <div class="container-fluid">
        <div class="row">
            <div class="col-12">
                <table class="table table-striped table-hover table-bordered">
                    <thead>
                        <tr>
                            <th>الكتاب</th>
                            <th>الاجراءات</th>

                        </tr>

                    </thead>
                    <tbody>
                        @foreach (BookModel book in Model)
                        {
                            <tr>
                                <td>
                                    @book.Name

                                </td>


                                <td>
                                    <input type="submit" value="حذف" class="btn btn-primary " style="background:blue" asp-action="Delete" asp-route-id="@book.Id" />
                                    <input type="submit" value="تعديل" class="btn btn-primary " style="background:blue" asp-action="Edit" asp-route-id="@book.Id" />

                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</form>



