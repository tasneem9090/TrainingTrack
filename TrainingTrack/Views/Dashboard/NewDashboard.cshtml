
@{
    Layout = null;
}


<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>

    <link href="~/lib/bootstrap/dist/css/bootstrap.css" rel="stylesheet" type="text/css" />
    <script src="~/lib/jquery/dist/jquery.js" type="text/javascript"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.js" type="text/javascript"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.js" type="text/javascript"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <!-- Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://jsdelivr.net">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">

    @*     <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
 *@

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>إدارة البرنامج </title>

    <!-- Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.rtl.min.css"
          rel="stylesheet">

    <!-- Bootstrap Icons -->
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <!-- Google Font -->
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800&display=swap"
          rel="stylesheet">

    <style>
        :root {
            --primary: #123b5d;
            --primary-dark: #0b2942;
            --secondary: #159a9c;
            --gold: #d6a84f;
            --light-bg: #f4f7fa;
            --text: #263746;
            --muted: #7b8794;
            --border: #e5eaf0;
            --white: #ffffff;
        }

        * {
            font-family: "Cairo", sans-serif;
        }

        body {
            background: var(--light-bg);
            color: var(--text);
            margin: 0;
        }

        /* =========================
                           SIDEBAR
                        ========================== */

        .sidebar {
            position: fixed;
            right: 0;
            top: 0;
            width: 270px;
            height: 100vh;
            background: linear-gradient( 180deg, var(--primary-dark), var(--primary) );
            color: white;
            z-index: 1000;
            overflow-y: auto;
        }

        .brand {
            padding: 25px 20px;
            border-bottom: 1px solid rgba(255,255,255,.12);
            text-align: center;
        }

        .brand-logo {
            width: 58px;
            height: 58px;
            margin: auto;
            border-radius: 15px;
            background: rgba(255,255,255,.12);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 28px;
            color: #fff;
            margin-bottom: 12px;
        }

        .brand h5 {
            margin: 0;
            font-weight: 700;
        }

        .brand small {
            color: rgba(255,255,255,.65);
            font-size: 11px;
        }

        .menu-title {
            font-size: 11px;
            color: rgba(255,255,255,.45);
            padding: 22px 22px 8px;
        }

        .sidebar-menu {
            list-style: none;
            padding: 0 12px;
            margin: 0;
        }

            .sidebar-menu li {
                margin-bottom: 5px;
            }

            .sidebar-menu a {
                color: rgba(255,255,255,.78);
                text-decoration: none;
                display: flex;
                align-items: center;
                gap: 13px;
                padding: 13px 15px;
                border-radius: 10px;
                transition: .2s;
                font-size: 14px;
            }

                .sidebar-menu a i {
                    font-size: 18px;
                }

                .sidebar-menu a:hover,
                .sidebar-menu a.active {
                    background: rgba(255,255,255,.12);
                    color: white;
                }

                .sidebar-menu a.active {
                    border-right: 3px solid var(--gold);
                }

        /* =========================
                           MAIN
                        ========================== */

        .main {
            margin-right: 270px;
            min-height: 100vh;
        }

        .topbar {
            height: 75px;
            background: white;
            border-bottom: 1px solid var(--border);
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 30px;
        }

        .search-box {
            width: 330px;
            position: relative;
        }

            .search-box input {
                border: 1px solid var(--border);
                background: #f8fafc;
                border-radius: 10px;
                padding: 10px 42px 10px 15px;
                width: 100%;
                outline: none;
                font-size: 13px;
            }

            .search-box i {
                position: absolute;
                right: 15px;
                top: 12px;
                color: var(--muted);
            }

        .top-actions {
            display: flex;
            align-items: center;
            gap: 18px;
        }

        .notification {
            width: 40px;
            height: 40px;
            background: #f3f6f9;
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--primary);
            position: relative;
        }

            .notification span {
                position: absolute;
                top: 5px;
                left: 5px;
                width: 8px;
                height: 8px;
                background: #e74c3c;
                border-radius: 50%;
            }

        .profile {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .profile-img {
            width: 42px;
            height: 42px;
            border-radius: 50%;
            background: var(--primary);
            color: white;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: bold;
        }

        /* =========================
                           CONTENT
                        ========================== */

        .content {
            padding: 30px;
        }

        .page-title {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 25px;
        }

            .page-title h3 {
                font-weight: 800;
                margin-bottom: 5px;
            }

            .page-title p {
                color: var(--muted);
                margin: 0;
                font-size: 13px;
            }

        .btn-primary-custom {
            background: var(--primary);
            border: none;
            color: white;
            padding: 11px 18px;
            border-radius: 9px;
        }

            .btn-primary-custom:hover {
                background: var(--primary-dark);
                color: white;
            }

        /* =========================
                           KPI CARDS
                        ========================== */

        .stat-card {
            background: white;
            border: 1px solid var(--border);
            border-radius: 15px;
            padding: 20px;
            height: 100%;
            transition: .2s;
        }

            .stat-card:hover {
                transform: translateY(-3px);
                box-shadow: 0 8px 25px rgba(18,59,93,.08);
            }

        .stat-icon {
            width: 48px;
            height: 48px;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 22px;
            margin-bottom: 15px;
        }

        .icon-blue {
            background: #e8f1f8;
            color: #23628e;
        }

        .icon-teal {
            background: #e4f7f5;
            color: #159a9c;
        }

        .icon-gold {
            background: #fff5df;
            color: #bd8522;
        }

        .icon-purple {
            background: #f1eaff;
            color: #7650b8;
        }

        .stat-card h6 {
            color: var(--muted);
            font-size: 13px;
            margin-bottom: 8px;
        }

        .stat-card h3 {
            font-weight: 800;
            margin: 0;
        }

        /* =========================
                           CARDS
                        ========================== */

        .custom-card {
            background: white;
            border: 1px solid var(--border);
            border-radius: 15px;
            margin-bottom: 25px;
        }

        .card-header-custom {
            padding: 18px 20px;
            border-bottom: 1px solid var(--border);
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

            .card-header-custom h5 {
                margin: 0;
                font-size: 16px;
                font-weight: 700;
            }

        .card-body-custom {
            padding: 20px;
        }

        /* =========================
                           PROGRAM INFO
                        ========================== */

        .program-name {
            background: linear-gradient( 135deg, var(--primary), #1e638c );
            color: white;
            border-radius: 15px;
            padding: 25px;
            margin-bottom: 25px;
        }

            .program-name small {
                color: rgba(255,255,255,.7);
            }

            .program-name h4 {
                font-weight: 700;
                line-height: 1.8;
                margin-top: 8px;
            }

        .info-row {
            padding: 13px 0;
            border-bottom: 1px solid var(--border);
        }

            .info-row:last-child {
                border-bottom: 0;
            }

        .info-label {
            color: var(--muted);
            font-size: 13px;
            margin-bottom: 5px;
        }

        .info-value {
            font-weight: 600;
            font-size: 14px;
        }

        /* =========================
                           OBJECTIVE
                        ========================== */

        .objective {
            background: #f1f8fa;
            border-right: 4px solid var(--secondary);
            padding: 18px;
            border-radius: 8px;
            line-height: 2;
            font-size: 13px;
        }

        /* =========================
                           TRAINING AXES
                        ========================== */

        .axis {
            border: 1px solid var(--border);
            padding: 15px;
            border-radius: 12px;
            margin-bottom: 10px;
            display: flex;
            align-items: center;
            gap: 13px;
            transition: .2s;
        }

            .axis:hover {
                border-color: var(--secondary);
                background: #f9fdfd;
            }

        .axis-number {
            min-width: 35px;
            height: 35px;
            border-radius: 9px;
            background: var(--primary);
            color: white;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 700;
        }

        .axis-text {
            font-size: 13px;
            font-weight: 600;
        }

        /* =========================
                           PROGRESS
                        ========================== */

        .progress-item {
            margin-bottom: 20px;
        }

        .progress-item-header {
            display: flex;
            justify-content: space-between;
            font-size: 13px;
            margin-bottom: 8px;
        }

        .progress {
            height: 9px;
            border-radius: 20px;
            background: #edf1f5;
        }

        .progress-bar {
            border-radius: 20px;
            background: var(--secondary);
        }

        /* =========================
                           TABLE
                        ========================== */

        .table-custom {
            font-size: 13px;
        }

            .table-custom th {
                color: var(--muted);
                font-weight: 600;
                background: #f8fafc;
                border-bottom: 1px solid var(--border);
            }

            .table-custom td,
            .table-custom th {
                padding: 14px;
                vertical-align: middle;
            }

        .badge-success {
            background: #e4f7ef;
            color: #198754;
        }

        .badge-warning {
            background: #fff5df;
            color: #b47710;
        }

        /* =========================
                           RESPONSIVE
                        ========================== */

        .media(max - width: 991px) {
            .sidebar

        {
            width: 80px;
        }

        .brand h5,
        .brand small,
        .menu-title,
        .sidebar-menu span {
            display: none;
        }

        .brand-logo {
            width: 45px;
            height: 45px;
        }

        .sidebar-menu a {
            justify-content: center;
        }

            .sidebar-menu a.active {
                border-right: none;
                border-bottom: 3px solid var(--gold);
            }

        .main {
            margin-right: 80px;
        }

        .search-box {
            width: 200px;
        }

        }

        .media(max - width: 767px) {
            .sidebar

        {
            width: 0;
            overflow: hidden;
        }

        .main {
            margin-right: 0;
        }

        .content {
            padding: 15px;
        }

        .topbar {
            padding: 0 15px;
        }

        .search-box {
            display: none;
        }

        .page-title {
            display: block;
        }

            .page-title button {
                margin-top: 15px;
            }

        }
    </style>
</head>

<body>

    <!-- =========================
         SIDEBAR
    ========================== -->

    <aside class="sidebar">

        <div class="brand">

            <div class="brand-logo">
                <img src="~/images/Plogo.png.jpg"
                     alt="Logo"
                     width=100%
                     height=100%
                     object-fit=cover; />
          
            </div>





            <h9>الإبداع والتطوير</h9>
            <h9> PIXELSOFT</h9>

        </div>

        <div class="menu-title">
            القائمة الرئيسية
        </div>

        <ul class="sidebar-menu">

            <li>
                <a href="#" class="active">
                    <i class="bi bi-grid-1x2-fill"></i>
                    <span>الصفحة الرئيسية</span>
                </a>
            </li>

            <li>


                <a class="nav-link" asp-controller="Information" asp-action="NewInformation">

                    <i class="bi bi-info-circle-fill"></i>
                    <span>معلومات البرنامج</span>
                </a>
            </li>

            <li>
                <a class="nav-link" asp-controller="Survey" asp-action="NewSurvey">

                    <i class="bi bi-journal-bookmark-fill"></i>
                    <span>تقييم أداء</span>
                </a>
            </li>

            <li>
                <a class="nav-link" asp-controller="Trainer" asp-action="trainerList">
                    <i class="bi bi-person-video3"></i>
                    <span>الموظفون</span>
                </a>
            </li>

            <li>
                <a class="nav-link" asp-controller="DailyReport" asp-action="DailyReportList">
                    <i class="bi bi-clipboard-data-fill"></i>
                    <span>التقارير اليومية</span>
                </a>
            </li>

            <li>

                <a class="nav-link" asp-controller="BookDistribution" asp-action="BookDistributionList">

                    <i class="bi bi-box-seam-fill"></i>
                    <span>  المشاريع </span>
                </a>
            </li>
            <a class="nav-link" asp-controller="Trainee" asp-action="TraineeList">
            <li>
                <div class="menu-title">
                    الإحصائيات والمتابعة
                </div>
                </a>
            </li>

            <li>

                <a class="nav-link" asp-controller="Trainee" asp-action="TraineeList">
                    <i class="bi bi-bar-chart-fill"></i>
                    <span>إحصائيات العملاء</span>
                </a>
            </li>

            <li>
                <a href="#">
                    <i class="bi bi-geo-alt-fill"></i>
                    <span>المحافظات</span>
                </a>
            </li>

            <li>
                <a class="nav-link" asp-controller="Training" asp-action="TrainingList">

                    <i class="bi bi-calendar-check-fill"></i>
                    <span>المشاريع</span>
                </a>

            </li>

        </ul>

    </aside>


    <!-- =========================
         MAIN
    ========================== -->

    <main class="main">

        <!-- TOP BAR -->

        <header class="topbar">

            <div class="search-box">
                <i class="bi bi-search"></i>
                <input type="text"
                       placeholder="البحث في النظام...">
            </div>

            <div class="top-actions">

                <div class="notification">
                    <i class="bi bi-bell"></i>
                    <span></span>
                </div>

                <div class="profile">

                    <div>
                        <strong style="font-size:13px;">
                            مدير البرنامج
                        </strong>

                        <div style="font-size:11px;color:#888;">
                            لوحة التحكم
                        </div>
                    </div>

                    <div class="profile-img">
                        م
                    </div>

                </div>

            </div>

        </header>


        <!-- CONTENT -->

        <section class="content">

            <!-- PAGE TITLE -->

            <div class="page-title">

                <div>
                    <h3>الصفحة الرئيسية</h3>

                    <p>
                        نظرة عامة على برنامج التدريب ومؤشرات الإنجاز
                    </p>
                </div>
                <a class="nav-link" asp-controller="Training" asp-action="NewTraining">
                    <button class="btn btn-primary-custom">
                        <i class="bi bi-plus-lg"></i>
                        إضافة مشروع جديد
                    </button>
                </a>
            </div>


            <!-- PROGRAM NAME -->

            <div class="program-name">

                <small>PixelSoft للإبداع والتطوير</small>

                <h4>
                    شركة متخصصة في تطوير البرمجيات وتصميم المواقع الإلكترونية والتطبيقات،
                    وتقديم الحلول التقنية المبتكرة التي تساعد الشركات والأفراد على تطوير أعمالهم وتحقيق أهدافهم الرقمية.


                </h4>

                <div class="mt-3">

                    <span class="badge bg-light text-dark me-2">
                        Pixel
                    </span>

                    <span class="badge bg-light text-dark">
                        Soft
                    </span>

                </div>

            </div>


            <!-- STATISTICS -->

            <div class="row g-4 mb-4">

                <div class="col-xl-2 col-md-4 col-6">

                    <div class="stat-card">

                        <div class="stat-icon icon-blue">
                            <i class="bi bi-people-fill"></i>
                        </div>

                        <h6>عدد المستفيدين</h6>

                        <h3>2,000</h3>

                        <small class="text-success">
                            <i class="bi bi-arrow-up"></i>
                            مستفيدة
                        </small>

                    </div>

                </div>


                <div class="col-xl-2 col-md-4 col-6">

                    <div class="stat-card">

                        <div class="stat-icon icon-teal">
                            <i class="bi bi-geo-alt-fill"></i>
                        </div>

                        <h6>المحافظات</h6>

                        <h3>12</h3>

                        <small class="text-muted">
                            محافظة
                        </small>

                    </div>

                </div>


                <div class="col-xl-2 col-md-4 col-6">

                    <div class="stat-card">

                        <div class="stat-icon icon-gold">
                            <i class="bi bi-calendar3"></i>
                        </div>

                        <h6>الدورات التدريبية</h6>

                        <h3>80</h3>

                        <small class="text-muted">
                            دورة تطبيقية
                        </small>

                    </div>

                </div>


                <div class="col-xl-2 col-md-4 col-6">

                    <div class="stat-card">

                        <div class="stat-icon icon-purple">
                            <i class="bi bi-person-check-fill"></i>
                        </div>

                        <h6>الموظفين</h6>
                        <h2>@ViewBag.TrainerCount</h2>
                        @*                         <h2>@(ViewBag.TotalEmployees ?? 0)</h2>
 *@                        @* <small class="text-muted">عدد الموظفين</small> *@


                    </div>

                </div>


                <div class="col-xl-2 col-md-4 col-6">

                    <div class="stat-card">

                        <div class="stat-icon icon-blue">
                            <i class="bi bi-clock-fill"></i>
                        </div>

                        <h6>مدةالعمل</h6>

                        <h3>4</h3>

                        <small class="text-muted">
                            أيام العمل
                        </small>

                    </div>

                </div>


                <div class="col-xl-2 col-md-4 col-6">

                    <div class="stat-card">

                        <div class="stat-icon icon-teal">
                            <i class="bi bi-hourglass-split"></i>
                        </div>

                        <h6>ساعات يومية</h6>

                        <h3>5-6</h3>

                        <small class="text-muted">
                            ساعات
                        </small>

                    </div>

                </div>

            </div>


            <!-- MAIN GRID -->

            <div class="row">

                <!-- RIGHT -->

                <div class="col-lg-8">

                    <!-- PROGRAM INFO -->

                    <div class="custom-card">

                        <div class="card-header-custom">

                            <h5>
                                <i class="bi bi-info-circle text-primary"></i>
                                معلومات البرنامج
                            </h5>

                            <button class="btn btn-sm btn-light">
                                عرض التفاصيل
                            </button>

                        </div>

                        <div class="card-body-custom">

                            <div class="row">

                                <div class="col-md-6">

                                    <div class="info-row">

                                        <div class="info-label">
                                            الجهة الداعمة 
                                        </div>

                                        <div class="info-value">
                                            PixelSoft للإبداع والتطوير                                           
                                        </div>

                                    </div>


                                    <div class="info-row">

                                        <div class="info-label">
                                            الجهة المنفذة
                                        </div>

                                        <div class="info-value">
                                            PixelSoft للإبداع والتطوير
                                        </div>

                                    </div>

                                </div>


                                <div class="col-md-6">

                                    <div class="info-row">

                                        <div class="info-label">
                                            الفئة المستهدفة
                                        </div>

                                        <div class="info-value">
                                            تقديم الحلول التقنية
                                            والدعم الفني.

                                        </div>

                                    </div>


                                    <div class="info-row">

                                        <div class="info-label">
                                            تطوير الأنظمة والبرامج الإدارية.

                                        </div>

                                        <div class="info-value">
                                            12 محافظة في المملكة
                                        </div>

                                    </div>

                                </div>

                            </div>

                        </div>

                    </div>


                    <!-- OBJECTIVE -->

                    <div class="custom-card">

                        <div class="card-header-custom">

                            <h5>
                                <i class="bi bi-bullseye text-danger"></i>
                                الفكرة العامة
                            </h5>

                        </div>

                        <div class="card-body-custom">

                            <div class="objective">
                                PIXELSOFT هي شركة متخصصة في تطوير البرمجيات والحلول الرقمية الذكية.
                                نركز على تحويل الرؤى والأفكار إلى منتجات تقنية ملموسة 
                                وعالية الجودة من خلال دمج البرمجة الاحترافية بالتصميم الإبداعي،
                                لنساعد الشركات والأفراد على تحقيق التميز الرقمي والارتقاء بأعمالهم
                                يعزز فرص التوظيف أو  تطوير المشاريع
                                القائمة.

                            </div>

                        </div>

                    </div>


                    <!-- PARTICIPANT STATISTICS -->

                    <div class="custom-card">

                        <div class="card-header-custom">

                            <h5>
                                <i class="bi bi-bar-chart-fill text-primary"></i>
                                إحصائيات المشاركين
                            </h5>

                            <span class="badge bg-primary">
                                2,000 مستفيدة
                            </span>

                        </div>

                        <div class="card-body-custom">

                            <div class="progress-item">

